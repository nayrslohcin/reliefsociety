  "cards": [
    {
      "dot": "emerald",
      "title": "One set of files per person",
      "items": [
        "Each PERSON_NAME gets its own form, private sheet and schedule in Drive under Relief Society Meals/<name>/",
        "Setup also installs that person's two triggers: onSignup on the form, onResponsesEdit on the sheet",
        "Volunteers reach the schedule through the link added to the form description"
      ]
    },
    {
      "dot": "violet",
      "title": "Keeping people apart",
      "items": [
        "Every record is stored under p:<person>:… in Script Properties",
        "formId: and ssId: lookups tell the shared handlers whose form or sheet fired",
        "claimDate removes the taken date from the dropdown and closes the form when none are left"
      ]
    },
    {
      "dot": "rose",
      "title": "Privacy and limits",
      "items": [
        "Only the schedule is shared, view-only; phone numbers stay in the private sheet",
        "Google allows 20 triggers per project, so about 10 people at once; forgetPerson frees a spot"
      ]
    }
  ]
