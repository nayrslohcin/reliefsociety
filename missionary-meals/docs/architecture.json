  "cards": [
    {
      "dot": "emerald",
      "title": "One sign-up, three places",
      "items": [
        "claimDate takes the date off the dropdown first, then writes the name on the calendar",
        "If the calendar write fails, the row is in the responses sheet and the date is gone from the form, but the square still says available",
        "diagnoseSignups reports this without changing anything; repairCalendar puts missing names back"
      ]
    },
    {
      "dot": "violet",
      "title": "Running on a clock",
      "items": [
        "Every 5 minutes: closes the form all Sunday and reopens it at 7 PM, so online sign-ups can't clash with the paper sheet at church",
        "Nightly, 1–2 AM: drops past dates from the dropdown and greys their squares"
      ]
    },
    {
      "dot": "rose",
      "title": "Privacy",
      "items": [
        "Only the schedule is shared, view-only, and it shows names alone",
        "Phone numbers and emails stay in the private responses sheet; the email question is optional"
      ]
    }
  ]
